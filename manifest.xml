<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPaneApp">
  
  <!-- 這是增益集的唯一ID，隨機產生即可 -->
  <Id>d4b2e8d9-2f5a-4b6e-8c3a-9f7b1d2c3a4e</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>MyGenogram</ProviderName>
  <DefaultLocale>zh-TW</DefaultLocale>
  
  <DisplayName DefaultValue="家系圖繪製工具" />
  <Description DefaultValue="直接在 Word 中繪製家系圖並插入文件中" />

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <DefaultSettings>
    <!-- 【重要】發布到 GitHub Pages 後，請將這裡替換成您的 GitHub Pages 網址 -->
    <SourceLocation DefaultValue="https://您的帳號.github.io/您的專案名稱/index.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>